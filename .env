# Copy this file to .env and fill in your real values. Never commit .env itself.

# MongoDB Atlas connection string (see your FYP report's Pre-requisites section —
# free tier cluster, low-latency region e.g. Singapore for Pakistan-based deployment).
MONGODB_URI=mongodb+srv://pcodegame_db_user:8P9woaXQPL7bfD3Q@cluster0.7jf3kkk.mongodb.net/

# Port the Express server listens on. Unity's ApiConfig.baseUrl should point here,
# e.g. http://localhost:3000/api for local dev or http://<server-ip>:3000/api for a
# deployed build.
PORT=3000

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d
GEMINI_API_KEY=your_gemini_key_here